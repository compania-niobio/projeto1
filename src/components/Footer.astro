---
// Rodapé do site Azzaro (fica dentro da seção #desejo).
// O id #dTop e o atributo data-d="foot" são usados por site-renovado-azzaro/js/desire.js — não renomear.
import azzaroBranco300 from '../../site-renovado-azzaro/assets/templates/logo/azzaro-branco-responsivo/azzaro-branco-300.webp?url';
---
<footer class="d-foot" data-d="foot">
    <img class="d-foot-logo" src={azzaroBranco300} width="300" height="87" alt="AZZARO" loading="lazy" decoding="async">
    <p class="t-label d-foot-line">O desejo começa pela sua presença.</p>
    <button class="d-top" id="dTop" type="button">
        Rever o filme
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6"/></svg>
    </button>
</footer>
